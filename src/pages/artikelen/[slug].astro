---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const datum = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Amsterdam' }).format(d.date);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  datePublished: d.date.toISOString(),
  description: d.description,
  author: { '@type': 'Organization', name: 'Speurtocht Plus' },
};
---
<Base title={d.title} description={d.description}>
  <article>
    <div class="narrow" data-pagefind-body>
      <p class="crumbs"><a href="/artikelen">← Alle artikelen</a></p>
      <h1 data-pagefind-meta="title">{d.title}</h1>
      <p class="meta">Gepubliceerd op <time datetime={d.date.toISOString()}>{datum}</time></p>
      <Image class="cover" src={d.image} alt={d.imageAlt} width={1200} loading="eager" />
      <div class="prose"><Content /></div>
    </div>
    <div class="narrow cta">
      <h2>Zelf aan de slag?</h2>
      <p>Download de Speurtocht Plus app en maak binnen een paar minuten je eigen speurtocht.</p>
      <StoreBadges />
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
<style>
  article { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .crumbs { margin: 0 0 1rem; font-weight: 800; }
  .meta { color: var(--ink-soft); margin-bottom: 1.5rem; }
  .cover { width: 100%; height: auto; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 2rem; }
  .cta { margin-top: 3.5rem; padding: 2rem; background: var(--surface); border: 2px dashed var(--line); border-radius: var(--radius); }
</style>

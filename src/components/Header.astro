---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/download', label: 'Download', active: path.startsWith('/download') },
  { href: '/artikelen', label: 'Artikelen', active: path.startsWith('/artikelen') },
  { href: '/over-ons', label: 'Over ons', active: path.startsWith('/over-ons') },
  { href: '/contact', label: 'Contact', active: path.startsWith('/contact') },
  { href: '/zoeken', label: 'Zoeken', active: path.startsWith('/zoeken') },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Speurtocht Plus – naar de homepage">
      <Image src={logo} alt="" width={40} height={40} />
      <span>Speurtocht <b>Plus</b></span>
    </a>
    <button class="toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="hoofdmenu"><span></span><span></span><span></span></button>
    <nav id="hoofdmenu" aria-label="Hoofdmenu">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.toggle');
  const nav = document.getElementById('hoofdmenu');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 4.25rem; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); font-family: 'Fredoka Variable', sans-serif; font-weight: 500; font-size: 1.35rem; }
  .brand b { color: var(--green-600); font-weight: 600; }
  .brand img { width: 40px; height: 40px; }
  ul { display: flex; gap: 0.2rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 0.45rem 0.95rem; border-radius: 999px; text-decoration: none; color: var(--ink-soft); font-weight: 700; font-size: 1rem; }
  nav a:hover { color: var(--ink); background: var(--surface-2); }
  nav a[aria-current='page'] { color: #fff; background: linear-gradient(135deg, var(--blue-500), var(--green-500)); }
  .toggle { display: none; background: none; border: 0; cursor: pointer; padding: 0.6rem; border-radius: 12px; }
  .toggle span { display: block; width: 24px; height: 3px; border-radius: 3px; background: var(--ink); margin: 5px 0; }
  @media (max-width: 860px) {
    .toggle { display: block; }
    nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg); border-bottom: 1px solid var(--line); padding: 0.75rem 1.25rem 1.25rem; display: none; }
    nav.open { display: block; }
    ul { flex-direction: column; }
  }
</style>

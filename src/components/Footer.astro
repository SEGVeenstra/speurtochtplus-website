---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../config';
---
<footer class="site-footer">
  <div class="container grid">
    <div>
      <div class="brand"><Image src={logo} alt="" width={36} height={36} /><span>Speurtocht Plus</span></div>
      <p class="muted">Maak, deel en speel je eigen GPS-speurtocht.</p>
    </div>
    <address>
      <strong>Contact</strong>
      <span>{site.address.name}</span>
      <span>{site.address.street}</span>
      <span>{site.address.city}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </address>
    <div>
      <strong>Bedrijfsgegevens</strong>
      <span>KvK: {site.kvk}</span>
      <span>BTW: {site.btw}</span>
    </div>
    <div>
      <strong>Pagina's</strong>
      <ul>
        <li><a href="/download">Download</a></li>
        <li><a href="/artikelen">Artikelen</a></li>
        <li><a href="/over-ons">Over ons</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="container copy muted small">© 2024 – {new Date().getFullYear()} Speurtocht Plus</div>
</footer>
<style>
  .site-footer { background: var(--navy); color: #cfe9de; padding-block: 3.5rem 2rem; margin-top: 3rem; position: relative; }
  .site-footer::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 6px; background: linear-gradient(90deg, var(--blue-500), var(--green-500), var(--sun)); }
  .site-footer a { color: #8be8c0; }
  .grid { display: grid; gap: 2rem; grid-template-columns: 1.3fr 1fr 1fr 0.8fr; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: #fff; font-family: 'Fredoka Variable', sans-serif; font-weight: 500; font-size: 1.3rem; margin-bottom: 0.4rem; }
  strong { display: block; color: #fff; margin-bottom: 0.4rem; font-family: 'Fredoka Variable', sans-serif; font-weight: 500; }
  address { font-style: normal; }
  address span, div > span { display: block; }
  ul { list-style: none; padding: 0; margin: 0; }
  .muted { color: #8fb3a4; }
  .small { font-size: 0.92rem; }
  .copy { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid rgb(255 255 255 / 0.12); }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="Zoeken" description="Zoek op de website van Speurtocht Plus." noindex>
  <section>
    <div class="narrow">
      <span class="eyebrow">Zoeken</span>
      <h1>Zoeken</h1>
      <div id="search"></div>
      <p id="dev-note" hidden>De zoekfunctie werkt in de live site en na <code>npm run build</code>. In de dev-modus is er geen zoekindex.</p>
    </div>
  </section>
</Base>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" onerror="this.remove()" />
<script is:inline>
  (function () {
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = function () {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: {
        placeholder: 'Zoek op deze website', clear_search: 'Wissen', load_more: 'Meer resultaten laden',
        search_label: 'Zoeken', filters_label: 'Filters', zero_results: 'Geen resultaten voor [SEARCH_TERM]',
        many_results: '[COUNT] resultaten voor [SEARCH_TERM]', one_result: '[COUNT] resultaat voor [SEARCH_TERM]',
        alt_search: 'Geen resultaten voor [SEARCH_TERM]. Dit zijn de resultaten voor [DIFFERENT_TERM]',
        search_suggestion: 'Geen resultaten voor [SEARCH_TERM]. Probeer een van deze zoektermen:',
        searching: 'Zoeken naar [SEARCH_TERM]…' } });
    };
    s.onerror = function () { document.getElementById('dev-note').hidden = false; };
    document.head.appendChild(s);
  })();
</script>
<style is:global>
  :root { --pagefind-ui-primary: var(--green-600); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--surface-2); --pagefind-ui-font: 'Nunito Variable', sans-serif; --pagefind-ui-border-radius: 16px; }
</style>

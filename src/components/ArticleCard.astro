---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const datum = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Amsterdam' }).format(data.date);
---
<a class="card" href={`/artikelen/${article.id}`}>
  <div class="thumb"><Image src={data.image} alt="" width={800} height={450} /></div>
  <div class="body">
    <time datetime={data.date.toISOString()}>{datum}</time>
    <h3>{data.title}</h3>
    <p>{data.description}</p>
    <span class="more">Lees verder <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .card { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); border: 1px solid var(--line); transition: transform .2s; height: 100%; }
  .card:hover { transform: translateY(-5px) rotate(-0.4deg); }
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .card:hover img { transform: scale(1.05); }
  .body { padding: 1.2rem 1.4rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  time { font-size: 0.9rem; color: var(--ink-soft); font-weight: 700; }
  h3 { margin: 0.3rem 0 0.5rem; font-size: 1.25rem; }
  p { color: var(--ink-soft); font-size: 1rem; flex: 1; margin-bottom: 0.8rem; }
  .more { color: var(--link); font-weight: 800; }
  @media (prefers-reduced-motion: reduce) { .card, .thumb img { transition: none; } .card:hover, .card:hover img { transform: none; } }
</style>
